# Postgres + pgvector (Neon serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI Gateway (Vercel) — для embeddings и LLM extract/dedup
# Получить: https://vercel.com/d/ai-gateway → Create API Key
# Альтернатива: запустить `vercel link` + `vc env pull` — OIDC-токен будет подхвачен AI SDK автоматически
AI_GATEWAY_API_KEY=

# Альтернативно — прямой OpenAI ключ (если не используете AI Gateway)
# OPENAI_API_KEY=

# MCP HTTP server (опционально, M2+)
MCP_PORT=3000
MCP_HOST=0.0.0.0

# Logging
LOG_LEVEL=info
