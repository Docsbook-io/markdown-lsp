{
  "name": "markdown-lsp",
  "version": "0.2.0",
  "description": "Language Server Protocol implementation for Markdown with optional AI-canonicalized glossary that resolves synonyms across docs",
  "type": "module",
  "bin": {
    "markdown-lsp": "./bin/markdown-lsp"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./bridge": "./dist/bridge/index.js",
    "./indexer": "./dist/indexer/indexer.js",
    "./core": "./dist/core/index.js",
    "./parser": "./dist/indexer/parseMarkdown.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts --stdio",
    "migrate": "tsx scripts/apply-migration.ts",
    "test": "vitest run",
    "test:fast": "vitest run test/parseMarkdown.test.ts test/bridge.test.ts test/ai-disabled.test.ts",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test:fast"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "ai": "^6.0.191",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.31.2",
    "mdast-util-to-string": "^4.0.0",
    "postgres": "^3.4.4",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.22.7",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "bin/",
    "src/db/migrations/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "lsp",
    "language-server",
    "markdown",
    "marksman",
    "documentation",
    "docs",
    "wiki-links",
    "pgvector",
    "embeddings",
    "mcp",
    "ai"
  ],
  "author": "Dan Bondarev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docsbook-io/markdown-lsp.git"
  },
  "homepage": "https://github.com/Docsbook-io/markdown-lsp#readme",
  "bugs": {
    "url": "https://github.com/Docsbook-io/markdown-lsp/issues"
  }
}
